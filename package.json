{
  "name": "arspective-gtd",
  "productName": "Arspective GTD",
  "version": "1.4.2",
  "description": "Arspective GTD application for Windows",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:electron": "esbuild src/main/index.ts --bundle --platform=node --target=node20 --outfile=dist-electron/main/index.js --external:electron --external:better-sqlite3 && esbuild src/preload/index.ts --bundle --platform=node --target=node20 --outfile=dist-electron/preload/index.js --external:electron",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "gtd",
    "electron",
    "react",
    "productivity"
  ],
  "author": "Arspective",
  "license": "MIT",
  "dependencies": {
    "@tiptap/extension-link": "^3.32.2",
    "@tiptap/extension-underline": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.64.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tiptap-markdown": "^0.9.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
